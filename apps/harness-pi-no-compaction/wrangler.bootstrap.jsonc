{
  "$schema": "node_modules/wrangler/config-schema.json",
  // FIRST DEPLOYMENT ONLY: establishes the namespace before operation workers exist.
  // Never use this config to update an active host; deploy wrangler.jsonc afterward.
  "name": "managed-agents-harness-pi-no-compaction-v1",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "durable_objects": {
    "bindings": [{ "name": "PI_NO_COMPACTION_SESSIONS", "class_name": "PiNoCompactionSessionV1" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PiNoCompactionSessionV1"] }],
  "d1_databases": [{
    "binding": "SESSION_DIRECTORY",
    "database_name": "managed-agents-session-directory-v2",
    "database_id": "f3073080-5ca3-44f1-9466-ae5fe6524fff",
    "migrations_dir": "../agent-api/migrations"
  }]
}
