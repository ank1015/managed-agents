{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managed-agents-llm-gateway",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "routes": [{ "pattern": "llm-callbacks.acentric.dev", "custom_domain": true }],
  "vars": {
    "GATEWAY_URL": "https://gateway.acentric.dev",
    "SESSION_ROUTES": "{\"minimal-bash-v7\":\"MINIMAL_BASH_SESSIONS\"}"
  },
  // Explicitly clear the old recovery schedule when this drained release is deployed.
  "triggers": { "crons": [] },
  // Add each LLM-capable harness's existing namespace here and in SESSION_ROUTES.
  "durable_objects": { "bindings": [{ "name": "MINIMAL_BASH_SESSIONS", "class_name": "MinimalBashSessionV7", "script_name": "managed-agents-harness-minimal-bash-v7" }] }
}
