{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managed-agents-tool-pi-read",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "vars": {
    "EXECUTION_GATEWAY_URL": "https://execution.acentric.dev",
    // Harness routes and namespace bindings must be updated together.
    "SESSION_ROUTES": "{\"pi-no-compaction-v1\":\"PI_NO_COMPACTION_SESSIONS\"}",
    "CLOUDFLARE_IMAGES_ACCOUNT_ID": "62fc73035acad6807728e4385fc03df0",
    "CLOUDFLARE_IMAGES_VARIANT": "piread"
  },
  "triggers": { "crons": [] },
  "durable_objects": { "bindings": [{ "name": "PI_NO_COMPACTION_SESSIONS", "class_name": "PiNoCompactionSessionV1", "script_name": "managed-agents-harness-pi-no-compaction-v1" }] }
}
