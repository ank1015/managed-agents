{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managed-agents-tool-pi-write",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "vars": {
    "EXECUTION_GATEWAY_URL": "https://execution.acentric.dev",
    // No harness has adopted write yet. Add its namespace binding and route together.
    "SESSION_ROUTES": "{}"
  },
  "triggers": { "crons": [] }
}
