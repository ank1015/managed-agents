{
  "name": "@managed-agents/agent-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc --ip 127.0.0.1",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply SESSION_DIRECTORY --local"
  },
  "dependencies": { "@managed-agents/diagnostics": "workspace:*",
    "@managed-agents/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "esbuild": "0.27.3",
    "miniflare": "4.20260730.0",
    "wrangler": "4.116.0"
  }
}
