{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managed-agents-agent-api",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "managed-agents-api.acentric.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "d1_databases": [
    {
      "binding": "SESSION_DIRECTORY",
      "database_name": "managed-agents-session-directory-v2",
      "database_id": "f3073080-5ca3-44f1-9466-ae5fe6524fff",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PI_NO_COMPACTION_SESSIONS",
        "class_name": "PiNoCompactionSessionV1",
        "script_name": "managed-agents-harness-pi-no-compaction-v1"
      },
      {
        "name": "MINIMAL_BASH_SESSIONS",
        "class_name": "MinimalBashSessionV7",
        "script_name": "managed-agents-harness-minimal-bash-v7"
      }
    ]
  }
}
