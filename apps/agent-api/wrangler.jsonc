{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managed-agents-agent-api",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "managed-agents-api.acentric.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "SESSION_DIRECTORY",
      "database_name": "managed-agents-session-directory",
      "database_id": "73c0f0fd-b07d-4358-9a04-1f39a3e36d0f",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MINIMAL_BASH_SESSIONS",
        "class_name": "MinimalBashSession",
        "script_name": "managed-agents-harness-minimal-bash"
      }
    ]
  }
}
