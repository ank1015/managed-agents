{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managed-agents-execution-gateway-callback",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "routes": [{ "pattern": "execution-callbacks.acentric.dev", "custom_domain": true }],
  "vars": { "CALLBACK_ROUTES": "{\"tool-pi-bash-v1\":\"BASH_EVENTS\",\"tool-pi-read-v1\":\"READ_EVENTS\",\"tool-pi-write-v1\":\"WRITE_EVENTS\",\"tool-pi-edit-v1\":\"EDIT_EVENTS\"}" },
  "services": [
    { "binding": "BASH_EVENTS", "service": "managed-agents-tool-pi-bash", "entrypoint": "PiBashCallbacks" },
    { "binding": "READ_EVENTS", "service": "managed-agents-tool-pi-read", "entrypoint": "PiReadCallbacks" },
    { "binding": "WRITE_EVENTS", "service": "managed-agents-tool-pi-write", "entrypoint": "PiWriteCallbacks" },
    { "binding": "EDIT_EVENTS", "service": "managed-agents-tool-pi-edit", "entrypoint": "PiEditCallbacks" }
  ],
  "triggers": { "crons": [] }
}
