{
  "$schema": "node_modules/wrangler/config-schema.json",
  // FIRST DEPLOYMENT ONLY: establishes the namespace before operation workers exist.
  // Never use this config to update an active host; deploy wrangler.jsonc afterward.
  "name": "managed-agents-harness-minimal-bash",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MINIMAL_BASH_SESSIONS", "class_name": "MinimalBashSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MinimalBashSession"] }],
  "d1_databases": [{
    "binding": "SESSION_DIRECTORY",
    "database_name": "managed-agents-session-directory",
    "database_id": "73c0f0fd-b07d-4358-9a04-1f39a3e36d0f",
    "migrations_dir": "../agent-api/migrations"
  }]
}
