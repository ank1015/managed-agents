{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managed-agents-execution-gateway-v1",
  "account_id": "62fc73035acad6807728e4385fc03df0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "routes": [{ "pattern": "execution-api.acentric.dev", "custom_domain": true }],
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  "durable_objects": { "bindings": [{ "name": "MACHINES", "class_name": "Machine" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Machine"] }],
  "services": [
    { "binding": "BASH_EVENTS", "service": "managed-agents-tool-pi-bash", "entrypoint": "PiBashCallbacks" },
    { "binding": "READ_EVENTS", "service": "managed-agents-tool-pi-read", "entrypoint": "PiReadCallbacks" },
    { "binding": "EDIT_EVENTS", "service": "managed-agents-tool-pi-edit", "entrypoint": "PiEditCallbacks" },
    { "binding": "APPLY_PATCH_EVENTS", "service": "managed-agents-tool-codex-apply-patch", "entrypoint": "CodexApplyPatchCallbacks" },
    { "binding": "WRITE_EVENTS", "service": "managed-agents-tool-pi-write", "entrypoint": "PiWriteCallbacks" }
  ],
  "vars": {
    "CALLBACK_ROUTES": "{\"tool-pi-bash-v1\":\"BASH_EVENTS\",\"tool-pi-write-v1\":\"WRITE_EVENTS\",\"tool-pi-read-v1\":\"READ_EVENTS\",\"tool-pi-edit-v1\":\"EDIT_EVENTS\",\"tool-codex-apply-patch-v1\":\"APPLY_PATCH_EVENTS\"}",
    "MAX_PENDING_SUBMISSIONS": "8",
    "MAX_CONCURRENT_DELIVERIES": "16",
    "MAX_BUFFERED_BYTES": "16777216",
    "ACCEPT_TIMEOUT_MS": "5000",
    "CALLBACK_TIMEOUT_MS": "30000"
  }
}
